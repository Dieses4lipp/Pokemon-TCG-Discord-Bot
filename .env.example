# Copy to .env and fill in. Never commit .env.

# Discord bot token (required)
TOKEN=

# Discord user ID allowed to run the admin commands; defaults to the owner of the Discord application
OWNER_ID=

# Database: sqlite (default) or postgres
DB_PROVIDER=sqlite

# SQLite only: the database file; defaults to data/bot.db next to the binary (/app/data/bot.db in the container)
# DATABASE_PATH=data/bot.db

# Postgres only (required there, must be unset for sqlite). The tables go into the schema "pokebot".
# DB_CONNECTION=Host=db.lan;Port=5432;Database=apps;Username=pokebot;Password=change-me
