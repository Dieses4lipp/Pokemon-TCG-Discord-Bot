  <ItemGroup>
    <ProjectReference Include="..\..\DiscordBot.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Data\packSettings.json" Link="Data\packSettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
